# Virtual environment (like vendor/).
.venv/
# Secrets.
.env
# Python cache files.
__pycache__/
*.pyc
# pytest cache folder.
.pytest_cache/
# Test coverage data and HTML reports (pytest-cov).
.coverage
htmlcov/
# Ruff cache folder.
.ruff_cache/
# User uploads and collected static files.
media/
staticfiles/
# macOS system files.
.DS_Store
# Editor folders.
.idea/
.vscode/
# Celery Beat runtime state (last run times), rewritten while Beat runs.
celerybeat-schedule*

