# Copy this file to .env and fill in real values. .env is NOT committed to git.
# Secret key for signing sessions, cookies, tokens. Like Laravel's APP_KEY.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Show detailed error pages. Only True on your own machine.
DJANGO_DEBUG=True
# Hosts this site can be served from, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full database connection in one URL: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Port 5433 = the Docker Postgres (see section 10 for why not 5432).
DATABASE_URL=postgres://taskflow:taskflow@localhost:5433/taskflow